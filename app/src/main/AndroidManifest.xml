<?xml version="1.0" encoding="utf-8"?>
<!-- Spec 001 HOME + Spec 002 / RF-002-03 package visibility (no QUERY_ALL_PACKAGES). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Spec 009 / RF-009-01 — expand QS / notifications panel (normal permission). -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />

    <!-- Spec 012 / RF-012-01, RF-012-08 — read next event only (no WRITE_CALENDAR). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Spec 015 / RF-015-06 — phase/cycle notifications (runtime on API 33+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Spec 021 / RF-021-07 — vibrate on Pomodoro phase-end alerts (normal permission). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Spec 015 / RF-015-05 — exact end-of-phase alarms (timer role). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Spec 015 / RF-015-02 — reschedule running session after reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".KvasirApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kvasir">

        <!--
          RF-001-03: singleTask + clearTaskOnLaunch + stateNotNeeded.
          Spec also named resumeOnTaskLaunch — that attribute does not exist in
          the platform Manifest schema (AAPT). resumeWhilePausing is the real
          launcher flag used by AOSP Launcher3 for the same warm-resume intent.
        -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:enableOnBackInvokedCallback="true"
            android:theme="@style/Theme.Kvasir">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Spec 015 — alarm + stop via explicit PendingIntent; boot via filter. -->
        <receiver
            android:name=".data.pomodoro.PomodoroAlarmReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Spec 017 / RF-017-01 — notification badges (package set only; no content UI). -->
        <service
            android:name=".data.notifications.KvasirNotificationListenerService"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>

</manifest>
